rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection
    match /test/{docId} {
      allow read: if true;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId)
        && incoming().displayName is string
        && incoming().displayName.size() <= 50
        && incoming().avatar is string
        && incoming().avatar.size() <= 50;
      allow delete: if false;
    }

    // Global Leaderboard collection
    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if incoming().userId is string
        && incoming().playerName is string
        && incoming().playerName.size() <= 50
        && incoming().playerAvatar is string
        && incoming().level is number
        && incoming().score is number;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Multiplayer Rooms collection
    match /multiplayer_rooms/{roomId} {
      allow read: if true;
      allow create: if incoming().hostId is string
        && incoming().roomCode is string
        && incoming().roomCode.size() <= 10;
      allow update, delete: if true;
    }

    // Matchmaking Queue collection
    match /matchmaking_queue/{queueId} {
      allow read: if true;
      allow create: if incoming().userId is string;
      allow update, delete: if true;
    }
  }
}
